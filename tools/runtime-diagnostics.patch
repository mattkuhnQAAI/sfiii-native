+            if(state_save_busy()) throw std::runtime_error("Wait for the native state write to finish");
+            state_check_file(path.string());
+            std::ofstream request(g_cfg.out+"/native-state-request.txt",std::ios::binary);
+            if(!request || !request.write(path.string().data(),path.string().size()) || !request.flush())
+                throw std::runtime_error("Cannot request native state load");
+            request.close();menu_close();sat_stop("native state load requested");
+        }
+    } catch(const std::exception& e) {
