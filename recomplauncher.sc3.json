{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Shining Force III Recomp — Scenario 3",
  "repo": "docerol/sfiii-recomp",
  "inputs": [
    {
      "id": "game",
      "label": "Your Shining Force III Scenario 3 disc image (.cue/.bin), Japanese release (GS-9203).",
      "formats": [
        {
          "type": "file"
        }
      ],
      "check": {
        "iso9660": "IP.BIN"
      },
      "dumps": [
        {
          "name": "Shining Force III Scenario 3 (JP) GS-9203 V1.001",
          "size": 510066480,
          "crc32": "5B65BFE3"
        }
      ]
    }
  ],
  "start": {
    "program": [
      "saturn",
      "saturn.exe"
    ],
    "args": [
      "--data",
      "{data}",
      "--cue",
      "{input:game}"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{data}/saturn-recomp/settings.ini"
        }
      ],
      "new": {
        "display.aspect": "4:3",
        "audio.volume": "100"
      }
    }
  ],
  "settings": [
    {
      "id": "aspect",
      "label": "Aspect ratio",
      "help": "16:9 is widescreen; 4:3 is the original.",
      "choices": [
        {
          "label": "4:3",
          "set": {
            "display.aspect": "4:3"
          }
        },
        {
          "label": "16:9",
          "set": {
            "display.aspect": "16:9"
          }
        }
      ],
      "defaults": {
        "display.aspect": "4:3"
      }
    },
    {
      "id": "scale",
      "label": "Internal resolution",
      "slider": {
        "key": "display.internal_scale",
        "min": 1,
        "max": 4,
        "step": 1,
        "format": "%d"
      },
      "defaults": {
        "display.internal_scale": "1"
      }
    },
    {
      "id": "volume",
      "label": "Volume",
      "slider": {
        "key": "audio.volume",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%d"
      },
      "defaults": {
        "audio.volume": "100"
      }
    }
  ],
  "saves": [
    "{data}"
  ]
}
